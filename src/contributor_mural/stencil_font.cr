    # Unknown characters render blank. `StencilConfig#validate` is the gate
    # that tells the user about them, and it runs before any rendering; this
    # fallback only keeps an unvalidated `Config.parse` from raising.
    def self.glyph(char : Char) : Array(String)
      GLYPHS[char]? || BLANK
    end

    def self.supports?(char : Char) : Bool
      GLYPHS.has_key?(char)
    end

    # The font is uppercase-only, and ❤ (U+2764, usually with a variation
    # selector) is what people actually paste when they mean ♥.
    def self.normalize(text : String) : String
      text.upcase.gsub('\u{2764}', '♥').delete('\u{FE0F}')
    end

    # Normalized lines with trailing blank lines trimmed; interior blank lines
    # are kept and read as a vertical gap.
    def self.lines(text : String) : Array(Array(Char))
      rows = normalize(text).split('\n').map(&.rstrip.chars)
      while !rows.empty? && rows.last.empty?
        rows.pop
      end
      while !rows.empty? && rows.first.empty?
        rows.shift
      end
      rows
    end
